# Application
APP_NAME=Home Library
APP_ENV=development
APP_SECRET_KEY=change-this-secret

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./home_library.sqlite3

# Initial admin
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5
OLLAMA_TIMEOUT_SECONDS=60

# External book search
ENABLE_OPEN_LIBRARY=true
ENABLE_GOOGLE_BOOKS=false
GOOGLE_BOOKS_API_KEY=

