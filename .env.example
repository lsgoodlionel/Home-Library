# =============================================================================
# Home Library 环境变量配置模板
# =============================================================================
# 使用方法：
#   cp .env.example .env
#   按本地情况修改 .env（.env 已在 .gitignore 中，不会提交到仓库）
# =============================================================================

# =============================================================================
# 应用基础
# =============================================================================

# 应用名称，显示在页面标题和日志中
APP_NAME=Home Library

# 运行环境：development | production | test
APP_ENV=development

# JWT 签名密钥，生产环境必须替换为足够长的随机字符串
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-this-secret

# JWT Token 有效期（秒），默认 86400 = 24 小时
APP_ACCESS_TOKEN_EXPIRE_SECONDS=86400

# =============================================================================
# 后端服务
# =============================================================================

# Docker / Nginx 对外访问端口；若 80 被占用可改为 8080
HTTP_PORT=80

# FastAPI 监听地址，本地开发使用 127.0.0.1，Docker 内使用 0.0.0.0
BACKEND_HOST=127.0.0.1

# FastAPI 监听端口
BACKEND_PORT=8000

# 数据库连接字符串
# SQLite（默认，MVP 推荐）：sqlite:///./home_library.sqlite3
# PostgreSQL（生产可选）：postgresql+asyncpg://user:password@localhost:5432/home_library
DATABASE_URL=sqlite:///./home_library.sqlite3

# Docker PostgreSQL 可选 profile 配置；启用时执行 docker compose --profile postgres up -d
POSTGRES_DB=home_library
POSTGRES_USER=home_library
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# PostgreSQL 连接示例：postgresql+psycopg://home_library:change-me@postgres:5432/home_library

# 允许跨域访问的前端地址，多个地址用逗号分隔
# 开发时设为 http://localhost:5173，生产时改为实际域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# 初始管理员账号（仅首次初始化数据库时生效）
# =============================================================================

# 初始管理员登录名
INITIAL_ADMIN_USERNAME=admin

# 初始管理员密码，首次登录后系统会强制要求修改
INITIAL_ADMIN_PASSWORD=change-me

# =============================================================================
# 前端（Vite 环境变量，必须以 VITE_ 开头才能在浏览器端读取）
# =============================================================================

# 后端 API 基础地址，前端所有请求都以此为前缀
# 开发时与后端地址对应，生产时改为反向代理地址
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# 应用标题（可选，用于 <title> 和页面头部）
VITE_APP_TITLE=家藏书库

# =============================================================================
# Ollama 本地 AI 模型
# =============================================================================

# Ollama 服务地址，本机运行时默认为 http://127.0.0.1:11434
# Docker 内部访问时可改为 http://ollama:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Docker Compose 中后端容器访问 Ollama 的地址
# 使用宿主机 Ollama： http://host.docker.internal:11434
# 使用 compose ollama profile： http://ollama:11434
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# 默认使用的模型，中文图书分类推荐 qwen2.5 或 qwen3
# 其他可选：llama3.1、gemma、deepseek-r1、mistral
OLLAMA_DEFAULT_MODEL=qwen2.5

# Ollama 请求超时时间（秒），分类推荐等任务建议 60 秒以上
OLLAMA_TIMEOUT_SECONDS=60

# Ollama 不可用时是否降级（true = 继续运行，AI 功能返回错误；false = 启动时报错）
OLLAMA_OPTIONAL=true

# =============================================================================
# 外部书籍检索数据源
# =============================================================================

# Open Library（https://openlibrary.org）
# 公开 API，无需 Key，默认启用
ENABLE_OPEN_LIBRARY=true

# Google Books API（https://developers.google.com/books）
# 需要申请 API Key，不启用时不会调用
ENABLE_GOOGLE_BOOKS=false
GOOGLE_BOOKS_API_KEY=

# 外部检索请求超时时间（秒）
EXTERNAL_SEARCH_TIMEOUT_SECONDS=10

# 每次检索最多返回候选条目数
EXTERNAL_SEARCH_MAX_RESULTS=5

# =============================================================================
# 文件上传与存储
# =============================================================================

# 封面图片和上传文件的本地存储目录（相对于后端根目录）
UPLOAD_DIR=./uploads

# 单文件上传大小限制（字节），默认 10MB
MAX_UPLOAD_SIZE_BYTES=10485760

# =============================================================================
# 日志
# =============================================================================

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 是否输出 JSON 格式日志（生产环境推荐 true）
LOG_JSON=false
