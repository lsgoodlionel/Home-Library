FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_HTTP_TIMEOUT=120

COPY --from=ghcr.io/astral-sh/uv:0.5.26 /uv /usr/local/bin/uv

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl sqlite3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

COPY backend/ /app/backend/
COPY scripts/ /app/scripts/

RUN uv pip install --system .

ENV BACKEND_HOST=0.0.0.0 \
    BACKEND_PORT=8000 \
    DATABASE_URL=sqlite:////data/home_library.sqlite3 \
    UPLOAD_DIR=/uploads

EXPOSE 8000

CMD ["sh", "-c", "python -c \"from app.db.session import SessionLocal; from app.db.init_db import init_db; db = SessionLocal(); init_db(db); db.close()\" && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
